{
  "name": "@multica/web",
  "version": "0.12.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh -c 'next dev --hostname \"${MULTICA_BIND_HOST:-127.0.0.1}\" --port \"${FRONTEND_PORT:-3000}\"'",
    "build": "next build",
    "start": "sh -c 'next start --hostname \"${MULTICA_BIND_HOST:-127.0.0.1}\"'",
    "typecheck": "tsc --noEmit",
    "typegen": "next typegen",
    "lint": "eslint .",
    "test": "vitest run",
    "mdx": "fumadocs-mdx",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@multica/core": "workspace:*",
    "@multica/ee": "workspace:*",
    "@multica/ui": "workspace:*",
    "@multica/views": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "dotenv": "^17.4.1",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "tw-animate-css": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@multica/eslint-config": "workspace:*",
    "@multica/vitest-setup": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "postcss": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
